# a chave usada em tudo no site (obrigatória)
OPENAI_API_KEY_PROFESSOR=
# modelo de texto (fato, sextilha, correção) — formato do AI SDK: provider:modelo
CORDEL_TEXT_MODEL=openai:gpt-6-luna
CORDEL_REASONING=low
# candidatas corrigidas em paralelo; com mais de uma aprovada, um júri escolhe (1 sai mais barato)
CORDEL_CANDIDATAS=3
# freio de gasto por geração (US$): passou, não chama júri nem faz mais correções
CORDEL_TETO_USD=0.10
# rodadas de correção antes do descarte
CORDEL_MAX_RODADAS=10
# imagem: um modelo "hospedeiro" chama a ferramenta image_generation da OpenAI
CORDEL_IMAGE_HOST_MODEL=openai:gpt-6-luna
# minima (gpt-image-1-mini) | low (gpt-image-2) | medium (gpt-image-2)
CORDEL_IMAGE_QUALITY=minima
