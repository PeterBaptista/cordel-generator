# a chave de quem gera com login (opcional: sem ela, cada pessoa usa a própria chave,
# que vai do navegador a cada geração e não é gravada)
OPENAI_API_KEY_PROFESSOR=
# contas: código de convite da turma (vazio = só o admin cria contas, em /admin)
CORDEL_CONVITE=
# logins de admin (painel /admin), separados por vírgula
CORDEL_ADMINS=
# gerações por dia por pessoa com a chave do professor
CORDEL_COTA_DIA=10
# freio de gasto por geração quando a chave é do próprio usuário (US$)
CORDEL_TETO_PROPRIA_USD=0.50
# modelo de texto (fato, sextilha, correção) — formato do AI SDK: provider:modelo
CORDEL_TEXT_MODEL=openai:gpt-6-luna
CORDEL_REASONING=low
# candidatas corrigidas em paralelo; com mais de uma aprovada, um júri escolhe (1 sai mais barato)
CORDEL_CANDIDATAS=3
# freio de gasto por geração (US$): passou, não chama júri nem faz mais correções
CORDEL_TETO_USD=0.10
# teto de rodadas de correção (cada geração tem 8 + 2 por estrofe, até este teto)
CORDEL_MAX_RODADAS=20
# imagem: um modelo "hospedeiro" chama a ferramenta image_generation da OpenAI
CORDEL_IMAGE_HOST_MODEL=openai:gpt-6-luna
# minima (gpt-image-1-mini) | low (gpt-image-2) | medium (gpt-image-2)
CORDEL_IMAGE_QUALITY=minima
# narração (ElevenLabs): a chave do professor só serve às contas de admin
ELEVENLABS_API_KEY=
# voz padrão da narração (uma de app/narracao.py VOZES; no site cada um escolhe a sua)
CORDEL_VOZ_PADRAO=cicero-sotaque
# dólar por mil créditos da ElevenLabs, para /logs (Starter: US$ 5 / 40 mil)
CORDEL_ELEVEN_USD_POR_1K=0.125
# música de fundo (Eleven Music): teto de segundos por música (~15 créditos por segundo)
CORDEL_MUSICA_MAX_SEGUNDOS=120
